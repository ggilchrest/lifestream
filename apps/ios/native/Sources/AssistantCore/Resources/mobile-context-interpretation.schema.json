{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifestream.dev/contracts/mobile-context-interpretation/1.0.0",
  "$defs": {
    "MobileInterpretationPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "schemaVersion",
        "digest"
      ],
      "properties": {
        "schemaId": {
          "const": "https://lifestream.dev/contracts/mobile-context-interpretation/1.0.0"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "MobileInterpretationQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enrollmentId",
        "assistantId",
        "startAt",
        "endAt"
      ],
      "properties": {
        "enrollmentId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "assistantId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "startAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 64
        },
        "endAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 64
        }
      }
    },
    "MobileInterpretationSelect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "choiceDigest"
      ],
      "properties": {
        "kind": {
          "const": "select"
        },
        "choiceDigest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "MobileInterpretationReverse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operationId"
      ],
      "properties": {
        "kind": {
          "const": "reverse"
        },
        "operationId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        }
      }
    },
    "MobileInterpretationChange": {
      "oneOf": [
        {
          "$ref": "#/$defs/MobileInterpretationSelect"
        },
        {
          "$ref": "#/$defs/MobileInterpretationReverse"
        }
      ]
    },
    "MobileInterpretationInspectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "operation",
        "query"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "operation": {
          "const": "inspect"
        },
        "query": {
          "$ref": "#/$defs/MobileInterpretationQuery"
        }
      }
    },
    "MobileInterpretationPreviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "operation",
        "operationId",
        "query",
        "expectedSourceRevision",
        "expectedInterpretationRevision",
        "change"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "operation": {
          "const": "preview"
        },
        "operationId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "query": {
          "$ref": "#/$defs/MobileInterpretationQuery"
        },
        "expectedSourceRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expectedInterpretationRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "change": {
          "$ref": "#/$defs/MobileInterpretationChange"
        }
      }
    },
    "MobileInterpretationMutationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "operation",
        "operationId",
        "query",
        "expectedSourceRevision",
        "expectedInterpretationRevision",
        "change",
        "reviewDigest",
        "controlOriginal"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "operation": {
          "enum": [
            "apply",
            "reverse"
          ]
        },
        "operationId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "query": {
          "$ref": "#/$defs/MobileInterpretationQuery"
        },
        "expectedSourceRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expectedInterpretationRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "change": {
          "$ref": "#/$defs/MobileInterpretationChange"
        },
        "reviewDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "controlOriginal": {
          "$ref": "https://lifestream.dev/contracts/mobile-context-control/1.0.0#/$defs/MobileControlRequest"
        }
      }
    },
    "MobileInterpretationReconcileRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "operation",
        "controlOriginal"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "operation": {
          "const": "reconcile"
        },
        "controlOriginal": {
          "$ref": "https://lifestream.dev/contracts/mobile-context-control/1.0.0#/$defs/MobileControlRequest"
        }
      }
    },
    "MobileInterpretationRequest": {
      "oneOf": [
        {
          "$ref": "#/$defs/MobileInterpretationInspectRequest"
        },
        {
          "$ref": "#/$defs/MobileInterpretationPreviewRequest"
        },
        {
          "$ref": "#/$defs/MobileInterpretationMutationRequest"
        },
        {
          "$ref": "#/$defs/MobileInterpretationReconcileRequest"
        }
      ]
    },
    "MobileInterpretationEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producerPin",
        "operation",
        "payload"
      ],
      "properties": {
        "producerPin": {
          "$ref": "#/$defs/MobileInterpretationPin"
        },
        "operation": {
          "const": "interpretation"
        },
        "payload": {
          "$ref": "#/$defs/MobileInterpretationRequest"
        }
      }
    },
    "MobileInterpretationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principalId",
        "collector",
        "sourceNamespace"
      ],
      "properties": {
        "principalId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "collector": {
          "enum": [
            "healthKit",
            "healthConnect"
          ]
        },
        "sourceNamespace": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        }
      }
    },
    "MobileInterpretationTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "endpointId",
        "enrollmentId",
        "assistantId"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/MobileInterpretationScope"
        },
        "endpointId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "enrollmentId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "assistantId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        }
      }
    },
    "MobileInterpretationCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "choiceDigest",
        "originalApp",
        "originalDevice",
        "recordCount"
      ],
      "properties": {
        "choiceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "originalApp": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "originalDevice": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "recordCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        }
      }
    },
    "MobileInterpretationSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithmVersion",
        "state",
        "sourceChoiceDigest",
        "selectionReason",
        "alternateChoiceDigests",
        "startAt",
        "endAt",
        "inBedMs",
        "asleepMs",
        "awakeMs",
        "stageMs",
        "gapMs",
        "recordedAwakeEpisodes",
        "lineage",
        "conflictingStages",
        "limitations"
      ],
      "properties": {
        "algorithmVersion": {
          "const": "sleep-union/1"
        },
        "state": {
          "enum": [
            "unknown",
            "recorded"
          ]
        },
        "sourceChoiceDigest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "selectionReason": {
          "enum": [
            "preferred",
            "stableSourceOrder",
            "noReadableRecords"
          ]
        },
        "alternateChoiceDigests": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uniqueItems": true
        },
        "startAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 64
        },
        "endAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 64
        },
        "inBedMs": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2678400000
            },
            {
              "type": "null"
            }
          ]
        },
        "asleepMs": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2678400000
            },
            {
              "type": "null"
            }
          ]
        },
        "awakeMs": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2678400000
            },
            {
              "type": "null"
            }
          ]
        },
        "stageMs": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "inBed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2678400000
            },
            "awake": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2678400000
            },
            "coreLight": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2678400000
            },
            "deep": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2678400000
            },
            "rem": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2678400000
            },
            "asleepUnspecified": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2678400000
            },
            "unknown": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2678400000
            }
          }
        },
        "gapMs": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2678400000
            },
            {
              "type": "null"
            }
          ]
        },
        "recordedAwakeEpisodes": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "lineage": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uniqueItems": true
        },
        "conflictingStages": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "MobileInterpretationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithmVersion",
        "timeBasis",
        "coverage",
        "totalAsleepMs",
        "sessions",
        "excludedNonSleepRecords",
        "excludedNonOverlappingSleepRecords",
        "deduplication",
        "limitations"
      ],
      "properties": {
        "algorithmVersion": {
          "const": "sleep-union/1"
        },
        "timeBasis": {
          "const": "elapsedUTC"
        },
        "coverage": {
          "enum": [
            "unknown",
            "partial"
          ]
        },
        "totalAsleepMs": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2678400000
            },
            {
              "type": "null"
            }
          ]
        },
        "sessions": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/MobileInterpretationSession"
          }
        },
        "excludedNonSleepRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "excludedNonOverlappingSleepRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "deduplication": {
          "const": "same-source-interval-union"
        },
        "limitations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "MobileInterpretationLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordId",
        "choiceDigest",
        "startAt",
        "endAt",
        "stage",
        "classification",
        "originalOffsetMinutes",
        "timeZone",
        "sourceLocalDate"
      ],
      "properties": {
        "recordId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "choiceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "startAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 64
        },
        "endAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 64
        },
        "stage": {
          "enum": [
            "inBed",
            "awake",
            "coreLight",
            "deep",
            "rem",
            "asleepUnspecified",
            "unknown"
          ]
        },
        "classification": {
          "enum": [
            "measured",
            "estimated",
            "unknown"
          ]
        },
        "originalOffsetMinutes": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": -840,
              "maximum": 840
            },
            {
              "type": "null"
            }
          ]
        },
        "timeZone": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceLocalDate": {
          "oneOf": [
            {
              "type": "string",
              "format": "date",
              "maxLength": 10
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "MobileInterpretationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetDigest",
        "policyBindingDigest",
        "sourceSafetyEpoch",
        "records",
        "readState",
        "timeBasis",
        "limitations"
      ],
      "properties": {
        "datasetDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policyBindingDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceSafetyEpoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "records": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/MobileInterpretationLineage"
          }
        },
        "readState": {
          "const": "boundedComplete"
        },
        "timeBasis": {
          "const": "elapsedUTC"
        },
        "limitations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "MobileInterpretationHistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "revision",
        "previousRevision",
        "kind",
        "reverseOf",
        "beforeChoiceDigest",
        "afterChoiceDigest",
        "appliedSourceRevision",
        "beforeSummaryDigest",
        "afterSummaryDigest",
        "reversible"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "previousRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "enum": [
            "select",
            "reverse"
          ]
        },
        "reverseOf": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "beforeChoiceDigest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "afterChoiceDigest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "appliedSourceRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "beforeSummaryDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "afterSummaryDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reversible": {
          "type": "boolean"
        }
      }
    },
    "MobileInterpretationInspectResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "query",
        "target",
        "sourceRevision",
        "interpretationRevision",
        "preferredChoiceDigest",
        "candidates",
        "summary",
        "provenance",
        "history",
        "historyCoverage",
        "limitations"
      ],
      "properties": {
        "state": {
          "const": "inspected"
        },
        "query": {
          "$ref": "#/$defs/MobileInterpretationQuery"
        },
        "target": {
          "$ref": "#/$defs/MobileInterpretationTarget"
        },
        "sourceRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "interpretationRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "preferredChoiceDigest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidates": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/MobileInterpretationCandidate"
          }
        },
        "summary": {
          "$ref": "#/$defs/MobileInterpretationSummary"
        },
        "provenance": {
          "$ref": "#/$defs/MobileInterpretationProvenance"
        },
        "history": {
          "type": "array",
          "maxItems": 25,
          "items": {
            "$ref": "#/$defs/MobileInterpretationHistoryEntry"
          }
        },
        "historyCoverage": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "limitations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "MobileInterpretationPreviewResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "operationId",
        "query",
        "target",
        "sourceRevision",
        "interpretationRevision",
        "nextInterpretationRevision",
        "change",
        "beforeChoiceDigest",
        "afterChoiceDigest",
        "before",
        "after",
        "provenance",
        "reviewDigest",
        "controlOriginal",
        "limitations"
      ],
      "properties": {
        "state": {
          "const": "ready"
        },
        "operationId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
        },
        "query": {
          "$ref": "#/$defs/MobileInterpretationQuery"
        },
        "target": {
          "$ref": "#/$defs/MobileInterpretationTarget"
        },
        "sourceRevision": {
          "type": "integer",
