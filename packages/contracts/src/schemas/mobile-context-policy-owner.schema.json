{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifestream.dev/contracts/mobile-context-policy-owner/1.0.0",
  "$defs": {
    "Choice": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "indefinite"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "finite"
            },
            "durationDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "anchor": {
              "enum": [
                "sourceEnd",
                "firstAuthoritativeImport"
              ]
            }
          },
          "required": [
            "mode",
            "durationDays",
            "anchor"
          ]
        }
      ]
    },
    "MappingScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "classification"
        },
        "category": {
          "enum": [
            "SleepSegment",
            "heartRate",
            "restingHeartRate",
            "respiratoryRate",
            "hrvSDNN",
            "hrvRMSSD"
          ]
        }
      },
      "required": [
        "kind",
        "category"
      ]
    },
    "RetentionScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "rawRetention"
        },
        "principalId": {
          "type": "string",
          "format": "uuid"
        },
        "collector": {
          "enum": [
            "healthKit",
            "healthConnect"
          ]
        },
        "sourceNamespace": {
          "type": "string",
          "format": "uuid"
        },
        "category": {
          "enum": [
            "SleepSegment",
            "heartRate",
            "restingHeartRate",
            "respiratoryRate",
            "hrvSDNN",
            "hrvRMSSD"
          ]
        }
      },
      "required": [
        "kind",
        "principalId",
        "collector",
        "sourceNamespace",
        "category"
      ]
    },
    "Scope": {
      "oneOf": [
        {
          "$ref": "#/$defs/MappingScope"
        },
        {
          "$ref": "#/$defs/RetentionScope"
        }
      ]
    },
    "Original": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operationId": {
              "type": "string",
              "format": "uuid"
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "scope": {
              "$ref": "#/$defs/MappingScope"
            },
            "command": {
              "const": "approveMapping"
            },
            "classification": {
              "enum": [
                "public",
                "personal",
                "sensitive",
                "restricted"
              ]
            }
          },
          "required": [
            "operationId",
            "expectedRevision",
            "scope",
            "command",
            "classification"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operationId": {
              "type": "string",
              "format": "uuid"
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "scope": {
              "$ref": "#/$defs/MappingScope"
            },
            "command": {
              "const": "revokeMapping"
            }
          },
          "required": [
            "operationId",
            "expectedRevision",
            "scope",
            "command"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operationId": {
              "type": "string",
              "format": "uuid"
            },
            "expectedRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "scope": {
              "$ref": "#/$defs/RetentionScope"
            },
            "command": {
              "const": "setRawRetention"
            },
            "mappingRevision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "choice": {
              "$ref": "#/$defs/Choice"
            }
          },
          "required": [
            "operationId",
            "expectedRevision",
            "scope",
            "command",
            "mappingRevision",
            "choice"
          ]
        }
      ]
    },
    "Pin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaId": {
          "const": "https://lifestream.dev/contracts/mobile-context-policy-owner/1.0.0"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schemaId",
        "schemaVersion",
        "digest"
      ]
    },
    "Envelope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "producerPin": {
              "$ref": "#/$defs/Pin"
            },
            "operation": {
              "const": "inspect"
            },
            "payload": {
              "$ref": "#/$defs/Scope"
            }
          },
          "required": [
            "producerPin",
            "operation",
            "payload"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "producerPin": {
              "$ref": "#/$defs/Pin"
            },
            "operation": {
              "enum": [
                "preview",
                "reconcile"
              ]
            },
            "payload": {
              "$ref": "#/$defs/Original"
            }
          },
          "required": [
            "producerPin",
            "operation",
            "payload"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "producerPin": {
              "$ref": "#/$defs/Pin"
            },
            "operation": {
              "const": "apply"
            },
            "payload": {
              "$ref": "#/$defs/Original"
            },
            "previewDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "producerPin",
            "operation",
            "payload"
          ]
        }
      ]
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receiptId": {
          "type": "string",
          "format": "uuid"
        },
        "operationId": {
          "type": "string",
          "format": "uuid"
        },
        "requestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scopeDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "decisionDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "committedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sqlCommit": {
          "const": true
        }
      },
      "required": [
        "receiptId",
        "operationId",
        "requestDigest",
        "scopeDigest",
        "revision",
        "decisionDigest",
        "committedAt",
        "sqlCommit"
      ]
    },
    "Terminal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "terminal"
        },
        "original": {
          "$ref": "#/$defs/Original"
        },
        "requestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "const": "applied"
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "family": {
              "const": "healthPolicy"
            },
            "reservationDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "preparedDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "terminalDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "family",
            "reservationDigest",
            "preparedDigest",
            "terminalDigest"
          ]
        },
        "receipt": {
          "$ref": "#/$defs/Receipt"
        }
      },
      "required": [
        "kind",
        "original",
        "requestDigest",
        "status",
        "binding",
        "receipt"
      ]
    },
    "Result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "held"
            },
            "reason": {
              "enum": [
                "unknown",
                "pending",
                "unavailable",
                "conflict",
                "configuration",
                "scope",
                "quota"
              ]
            }
          },
          "required": [
            "kind",
            "reason"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "ready"
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "affected": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "deleted": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "configDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "kind",
            "digest",
            "revision",
            "affected",
            "deleted",
            "configDigest"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "observed"
            },
            "operationId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "operationId"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "status"
            },
            "scope": {
              "$ref": "#/$defs/Scope"
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "value": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/Choice"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "classification": {
                      "enum": [
                        "public",
                        "personal",
                        "sensitive",
                        "restricted"
                      ]
                    }
                  },
                  "required": [
                    "classification"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "revoked": {
                      "const": true
                    }
                  },
                  "required": [
                    "revoked"
                  ]
                }
              ]
            },
            "canChangeDuration": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "scope",
            "revision",
            "value",
            "canChangeDuration"
          ]
        },
        {
          "$ref": "#/$defs/Terminal"
        }
      ]
    },
    "Response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "producerPin": {
          "$ref": "#/$defs/Pin"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "result": {
          "$ref": "#/$defs/Result"
        }
      },
      "required": [
        "producerPin",
        "schemaVersion",
        "result"
      ]
    }
  },
  "$ref": "#/$defs/Envelope"
}
