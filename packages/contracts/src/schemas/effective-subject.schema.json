{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifestream.dev/contracts/effective-subject/1.0.0",
  "oneOf": [
    {
      "$ref": "#/$defs/EffectiveSubjectContext"
    },
    {
      "$ref": "#/$defs/EffectiveSubjectRequest"
    },
    {
      "$ref": "#/$defs/AuthorizedUsersPage"
    },
    {
      "$ref": "#/$defs/EffectiveSubjectEvent"
    },
    {
      "$ref": "#/$defs/EffectiveSubjectError"
    }
  ],
  "$defs": {
    "EffectiveSubjectContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "actorId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "effectiveUserId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "authenticatedSessionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "installationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "authorityRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "schemaVersion",
        "actorId",
        "effectiveUserId",
        "authenticatedSessionId",
        "installationId",
        "authorityRevision",
        "generation",
        "issuedAt"
      ]
    },
    "EffectiveSubjectError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "code": {
          "enum": [
            "unauthenticated",
            "forbidden",
            "scopeChanged",
            "notFound",
            "unsupportedVersion",
            "invalidRequest",
            "revisionConflict",
            "invalidCursor",
            "restartPage",
            "unavailable",
            "idempotencyConflict",
            "backpressure"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        },
        "retryable": {
          "type": "boolean"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "schemaVersion",
        "code",
        "message",
        "retryable",
        "correlationId"
      ]
    },
    "DiscoverUsersRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "operationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "operation": {
          "const": "discoverUsers"
        },
        "expectedGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "query": {
              "type": "string",
              "minLength": 0,
              "maxLength": 512
            },
            "pageSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "cursor": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "query",
            "pageSize",
            "cursor"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "operationId",
        "operation",
        "expectedGeneration",
        "payload"
      ]
    },
    "StartContextRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "operationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "operation": {
          "const": "startContext"
        },
        "expectedGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "targetUserId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "targetUserId"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "operationId",
        "operation",
        "expectedGeneration",
        "payload"
      ]
    },
    "SwitchContextRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "operationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "operation": {
          "const": "switchContext"
        },
        "expectedGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "targetUserId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "targetUserId"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "operationId",
        "operation",
        "expectedGeneration",
        "payload"
      ]
    },
    "ReadContextRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "operationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "operation": {
          "const": "readContext"
        },
        "expectedGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        }
      },
      "required": [
        "schemaVersion",
        "operationId",
        "operation",
        "expectedGeneration",
        "payload"
      ]
    },
    "EndContextRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "operationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "operation": {
          "const": "endContext"
        },
        "expectedGeneration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        }
      },
      "required": [
        "schemaVersion",
        "operationId",
        "operation",
        "expectedGeneration",
        "payload"
      ]
    },
    "EffectiveSubjectRequest": {
      "oneOf": [
        {
          "$ref": "#/$defs/DiscoverUsersRequest"
        },
        {
          "$ref": "#/$defs/StartContextRequest"
        },
        {
          "$ref": "#/$defs/SwitchContextRequest"
        },
        {
          "$ref": "#/$defs/ReadContextRequest"
        },
        {
          "$ref": "#/$defs/EndContextRequest"
        }
      ]
    },
    "AuthorizedUser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "isSelf": {
          "type": "boolean"
        }
      },
      "required": [
        "userId",
        "displayName",
        "isSelf"
      ]
    },
    "AuthorizedUsersPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "users": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthorizedUser"
          },
          "maxItems": 50
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "users",
        "nextCursor"
      ]
    },
    "EffectiveSubjectEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "eventId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "eventSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "context": {
          "$ref": "#/$defs/EffectiveSubjectContext"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "type": {
          "enum": [
            "contextChanged",
            "authorizationRevoked"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "eventId",
        "eventSequence",
        "context",
        "occurredAt",
        "type"
      ]
    }
  }
}
