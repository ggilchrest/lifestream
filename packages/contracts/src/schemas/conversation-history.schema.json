{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifestream.dev/contracts/conversation-history/1.0.0",
  "oneOf": [
    {
      "$ref": "#/$defs/ConversationSummary"
    },
    {
      "$ref": "#/$defs/TimelineEntry"
    },
    {
      "$ref": "#/$defs/HistoryRequest"
    },
    {
      "$ref": "#/$defs/ConversationPage"
    },
    {
      "$ref": "#/$defs/TimelinePage"
    },
    {
      "$ref": "#/$defs/SearchPage"
    },
    {
      "$ref": "#/$defs/HistoryOperationResult"
    },
    {
      "$ref": "#/$defs/HistoryEvent"
    },
    {
      "$ref": "#/$defs/HistoryError"
    }
  ],
  "$defs": {
    "ConversationSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "conversationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "assistantId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "effectiveUserId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "title": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "lastActivityAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "archived": {
          "type": "boolean"
        },
        "pinned": {
          "type": "boolean"
        }
      },
      "required": [
        "schemaVersion",
        "conversationId",
        "assistantId",
        "effectiveUserId",
        "title",
        "revision",
        "createdAt",
        "lastActivityAt",
        "archived",
        "pinned"
      ]
    },
    "TimelineEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "entryId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "turnId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "conversationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "actorId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "effectiveUserId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "speaker": {
          "enum": [
            "human",
            "assistant",
            "system"
          ]
        },
        "modality": {
          "enum": [
            "text",
            "voice"
          ]
        },
        "state": {
          "enum": [
            "submitted",
            "accepted",
            "generating",
            "interrupted",
            "failed",
            "completed"
          ]
        },
        "content": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "state": {
                  "const": "retained"
                },
                "text": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 32768
                }
              },
              "required": [
                "state",
                "text"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "state": {
                  "enum": [
                    "redacted",
                    "unavailable"
                  ]
                }
              },
              "required": [
                "state"
              ]
            }
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "artifactRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "maxItems": 16
        }
      },
      "required": [
        "schemaVersion",
        "entryId",
        "turnId",
        "conversationId",
        "order",
        "actorId",
        "effectiveUserId",
        "speaker",
        "modality",
        "state",
        "content",
        "revision",
        "createdAt",
        "updatedAt",
        "artifactRefs"
      ]
    },
    "HistoryError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "code": {
          "enum": [
            "unauthenticated",
            "forbidden",
            "scopeChanged",
            "notFound",
            "unsupportedVersion",
            "invalidRequest",
            "revisionConflict",
            "invalidCursor",
            "restartPage",
            "unavailable",
            "idempotencyConflict",
            "backpressure"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        },
        "retryable": {
          "type": "boolean"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "schemaVersion",
        "code",
        "message",
        "retryable",
        "correlationId"
      ]
    },
    "CreateRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "operation": {
