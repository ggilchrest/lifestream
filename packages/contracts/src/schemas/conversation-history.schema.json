            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "pageSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 50
            },
            "cursor": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
