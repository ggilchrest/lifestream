            },
            "filter": {
              "enum": [
                "recent",
                "pinned",
                "archived"
              ]
            },
            "pageSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "cursor": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "assistantId",
            "filter"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "operation",
        "operationId",
        "payload"
      ]
    },
