            "pageSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 50
            },
            "cursor": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "conversationId",
            "direction"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "operation",
        "operationId",
        "payload"
      ]
    },
    "SearchRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "operation": {
