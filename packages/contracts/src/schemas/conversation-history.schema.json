        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "assistantId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "title": {
              "type": "string",
              "minLength": 0,
              "maxLength": 256
            }
          },
          "required": [
            "assistantId",
            "title"
          ]
        },
        "idempotencyKey": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "schemaVersion",
        "operation",
        "operationId",
        "payload",
        "idempotencyKey"
      ]
    },
    "ListRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "operation": {
