  "properties": {
    "schemaVersion": { "const": "2.0.0" }, "viewId": { "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID" }, "revision": { "type": "integer", "minimum": 1 }, "assistantId": { "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID" }, "userProfileId": { "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID" }, "relationshipId": { "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID" }, "conversationId": { "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID" }, "sessionId": { "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID" }, "endpointId": { "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID" }, "builtAt": { "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/Time" }, "freshUntil": { "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/Time" }, "staleUntil": { "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/Time" }, "sourceRevisions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }, "approvedBaseline": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } }, "criticalRestrictions": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } }, "sections": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "content", "referenceIds"], "properties": { "kind": { "enum": ["session", "conversation", "relationalMemory", "worldContext", "pendingWork"] }, "content": { "type": "string", "maxLength": 32000 }, "referenceIds": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 } } } } }, "omissions": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
  }
