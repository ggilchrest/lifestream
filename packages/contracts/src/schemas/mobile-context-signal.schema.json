{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifestream.dev/contracts/mobile-context-signal/1.0.0",
  "title": "Bounded caller-declared context signals; no OS execution, current world, human or action authority.",
  "$ref": "#/$defs/ContextSignal",
  "$defs": {
    "ContextSignalInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
    },
    "ContextSignalSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collector",
        "namespace",
        "upstreamId",
        "originalApp",
        "originalDevice"
      ],
      "properties": {
        "collector": {
          "enum": [
            "iosDeclaredIntent",
            "androidDeclaredIntent"
          ]
        },
        "namespace": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f-]+$"
        },
        "upstreamId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "originalApp": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "originalDevice": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ContextSignalDeclaration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "origin"
          ],
          "properties": {
            "kind": {
              "const": "reported"
            },
            "origin": {
              "enum": [
                "userConfiguredAutomation",
                "explicitUserInput"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "unknown"
            },
            "reason": {
              "enum": [
                "notProvided",
                "notObservable",
                "unsupported"
              ]
            }
          }
        }
      ]
    },
    "ContextFocusTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "sourceFocusId",
        "state"
      ],
      "properties": {
        "kind": {
          "const": "focusTransition"
        },
        "sourceFocusId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "enabled",
            "disabled",
            "unknown"
          ]
        }
      }
    },
    "ContextConnectionTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "connectionKind",
        "sourceDeviceId",
        "state"
      ],
      "properties": {
        "kind": {
          "const": "connectionTransition"
        },
        "connectionKind": {
          "enum": [
            "car",
            "bluetooth"
          ]
        },
        "sourceDeviceId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "connected",
            "disconnected",
            "unknown"
          ]
        }
      }
    },
    "ContextAvailabilityDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "state"
      ],
      "properties": {
        "kind": {
          "const": "availabilityDeclaration"
        },
        "state": {
          "enum": [
            "available",
            "busy",
            "doNotDisturb",
            "unavailable",
            "unknown"
          ]
        }
      }
    },
    "ContextUnknownNativeSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "nativeType",
        "rawValue"
      ],
      "properties": {
        "kind": {
          "const": "unknownNative"
        },
        "nativeType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "rawValue": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ContextSignalUnavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason"
      ],
      "properties": {
        "kind": {
          "const": "unavailable"
        },
        "reason": {
          "enum": [
            "notObservable",
            "unsupported",
            "temporarilyUnavailable",
            "unknown"
          ]
        }
      }
    },
    "ContextSignalPayload": {
      "oneOf": [
        {
          "$ref": "#/$defs/ContextFocusTransition"
        },
        {
          "$ref": "#/$defs/ContextConnectionTransition"
        },
        {
          "$ref": "#/$defs/ContextAvailabilityDeclaration"
        },
        {
          "$ref": "#/$defs/ContextUnknownNativeSignal"
        },
        {
          "$ref": "#/$defs/ContextSignalUnavailable"
        }
      ]
    },
    "ContextSignal": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "source",
            "observedAt",
            "collectedAt",
            "declaration",
            "signal"
          ],
          "properties": {
            "schemaVersion": {
              "const": "1.0.0"
            },
            "source": {
              "$ref": "#/$defs/ContextSignalSource"
            },
            "observedAt": {
              "$ref": "#/$defs/ContextSignalInstant"
            },
            "collectedAt": {
              "$ref": "#/$defs/ContextSignalInstant"
            },
            "declaration": {
              "$ref": "#/$defs/ContextSignalDeclaration"
            },
            "signal": {
              "$ref": "#/$defs/ContextFocusTransition"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "source",
            "observedAt",
            "collectedAt",
            "declaration",
            "signal"
          ],
          "properties": {
            "schemaVersion": {
              "const": "1.0.0"
            },
            "source": {
              "$ref": "#/$defs/ContextSignalSource"
            },
            "observedAt": {
              "$ref": "#/$defs/ContextSignalInstant"
            },
            "collectedAt": {
              "$ref": "#/$defs/ContextSignalInstant"
            },
            "declaration": {
              "$ref": "#/$defs/ContextSignalDeclaration"
            },
            "signal": {
              "$ref": "#/$defs/ContextConnectionTransition"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "source",
            "observedAt",
            "collectedAt",
            "declaration",
            "signal"
          ],
          "properties": {
            "schemaVersion": {
              "const": "1.0.0"
            },
            "source": {
              "$ref": "#/$defs/ContextSignalSource"
            },
            "observedAt": {
              "$ref": "#/$defs/ContextSignalInstant"
            },
            "collectedAt": {
              "$ref": "#/$defs/ContextSignalInstant"
            },
            "declaration": {
              "$ref": "#/$defs/ContextSignalDeclaration"
            },
            "signal": {
              "$ref": "#/$defs/ContextAvailabilityDeclaration"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "source",
            "observedAt",
            "collectedAt",
            "declaration",
            "signal"
          ],
          "properties": {
            "schemaVersion": {
              "const": "1.0.0"
            },
            "source": {
              "$ref": "#/$defs/ContextSignalSource"
            },
            "observedAt": {
              "$ref": "#/$defs/ContextSignalInstant"
            },
            "collectedAt": {
              "$ref": "#/$defs/ContextSignalInstant"
            },
            "declaration": {
              "$ref": "#/$defs/ContextSignalDeclaration"
            },
            "signal": {
              "$ref": "#/$defs/ContextUnknownNativeSignal"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "source",
            "observedAt",
            "collectedAt",
            "declaration",
            "signal"
          ],
          "properties": {
            "schemaVersion": {
              "const": "1.0.0"
            },
            "source": {
              "$ref": "#/$defs/ContextSignalSource"
            },
            "observedAt": {
              "oneOf": [
                {
                  "$ref": "#/$defs/ContextSignalInstant"
                },
                {
                  "type": "null"
                }
              ]
            },
            "collectedAt": {
              "$ref": "#/$defs/ContextSignalInstant"
            },
            "declaration": {
              "$ref": "#/$defs/ContextSignalDeclaration"
            },
            "signal": {
              "$ref": "#/$defs/ContextSignalUnavailable"
            }
          }
        }
      ]
    },
    "ContextSignalAgeContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceAt",
        "maximumAgeMs"
      ],
      "properties": {
        "referenceAt": {
          "$ref": "#/$defs/ContextSignalInstant"
        },
        "maximumAgeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "ContextSignalAgeAssessment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "ageNanoseconds",
            "maximumAgeMs",
            "qualification"
          ],
          "properties": {
            "state": {
              "enum": [
                "fresh",
                "stale"
              ]
            },
            "ageNanoseconds": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,23})$"
            },
            "maximumAgeMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "qualification": {
              "const": "observationAgeOnly"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason",
            "ageNanoseconds",
            "maximumAgeMs",
            "qualification"
          ],
          "properties": {
            "state": {
              "const": "unknown"
            },
            "reason": {
              "enum": [
                "unavailable",
                "futureObservation",
                "futureCollection",
                "observationAfterCollection"
              ]
            },
            "ageNanoseconds": {
              "type": "null"
            },
            "maximumAgeMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "qualification": {
              "const": "observationAgeOnly"
            }
          }
        }
      ]
    },
    "ContextSignalView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualification",
        "signal"
      ],
      "properties": {
        "qualification": {
          "const": "declaredSignalOnly"
        },
        "signal": {
          "$ref": "#/$defs/ContextSignalPayload"
        }
      }
    }
  }
}
