{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifestream.dev/contracts/mobile-context/1.0.0",
  "$defs": {
    "SourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collector",
        "namespace",
        "upstreamId"
      ],
      "properties": {
        "collector": {
          "enum": [
            "healthKit",
            "healthConnect"
          ]
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "upstreamId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "upstreamRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "originalApp": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "originalDevice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "originalAppVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "originalDeviceModel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "SleepSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "startAt",
        "endAt",
        "stage",
        "classification"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "startAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "endAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "originalOffsetMinutes": {
          "type": "integer",
          "minimum": -840,
          "maximum": 840
        },
        "timeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sourceLocalDate": {
          "type": "string",
          "format": "date"
        },
        "stage": {
          "enum": [
            "inBed",
            "awake",
            "coreLight",
            "deep",
            "rem",
            "asleepUnspecified",
            "unknown"
          ]
        },
        "nativeValue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "classification": {
          "enum": [
            "measured",
            "estimated",
            "unknown"
          ]
        }
      }
    },
    "MeasurementSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "value"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "HealthMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "startAt",
        "measure",
        "unit",
        "representation",
        "origin",
        "coverage"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "startAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "endAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "originalOffsetMinutes": {
          "type": "integer",
          "minimum": -840,
          "maximum": 840
        },
        "timeZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sourceLocalDate": {
          "type": "string",
          "format": "date"
        },
        "measure": {
          "enum": [
            "heartRate",
            "restingHeartRate",
            "respiratoryRate",
            "hrvSDNN",
            "hrvRMSSD"
          ]
        },
        "unit": {
          "enum": [
            "beatsPerMinute",
            "breathsPerMinute",
            "milliseconds"
          ]
        },
        "representation": {
          "enum": [
            "point",
            "interval",
            "series"
          ]
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/MeasurementSample"
          }
        },
        "origin": {
          "enum": [
            "observed",
            "calculated",
            "unknown"
          ]
        },
        "coverage": {
          "enum": [
            "unknown",
            "partial",
            "complete"
          ]
        }
      }
    },
    "MobileChange": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "eventId",
            "enrollmentId",
            "expectedPolicyRevision",
            "source",
            "collectedAt",
            "mappingVersion",
            "operation",
            "recordType",
            "record"
          ],
          "properties": {
            "schemaVersion": {
              "const": "1.0.0"
            },
            "eventId": {
              "type": "string",
              "format": "uuid"
            },
            "enrollmentId": {
              "type": "string",
              "format": "uuid"
            },
            "expectedPolicyRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "source": {
              "$ref": "#/$defs/SourceIdentity"
            },
            "collectedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "mappingVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "operation": {
              "const": "upsert"
            },
            "recordType": {
              "const": "HealthMeasurement"
            },
            "record": {
              "$ref": "#/$defs/HealthMeasurement"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "eventId",
            "enrollmentId",
            "expectedPolicyRevision",
            "source",
            "collectedAt",
            "mappingVersion",
            "operation",
            "recordType",
            "record"
          ],
          "properties": {
            "schemaVersion": {
              "const": "1.0.0"
            },
            "eventId": {
              "type": "string",
              "format": "uuid"
            },
            "enrollmentId": {
              "type": "string",
              "format": "uuid"
            },
            "expectedPolicyRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "source": {
              "$ref": "#/$defs/SourceIdentity"
            },
            "collectedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "mappingVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "operation": {
              "const": "upsert"
            },
            "recordType": {
              "const": "SleepSegment"
            },
            "record": {
              "$ref": "#/$defs/SleepSegment"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "eventId",
            "enrollmentId",
            "expectedPolicyRevision",
            "source",
            "collectedAt",
            "mappingVersion",
            "operation",
            "recordType"
          ],
          "properties": {
            "schemaVersion": {
              "const": "1.0.0"
            },
            "eventId": {
              "type": "string",
              "format": "uuid"
            },
            "enrollmentId": {
              "type": "string",
              "format": "uuid"
            },
            "expectedPolicyRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "source": {
              "$ref": "#/$defs/SourceIdentity"
            },
            "collectedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "mappingVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "operation": {
              "const": "delete"
            },
            "recordType": {
              "enum": [
                "HealthMeasurement",
                "SleepSegment"
              ]
            }
          }
        }
      ]
    },
    "IngestBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "changes"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/MobileChange"
          }
        }
      }
    },
    "ContextQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "enrollmentId",
        "assistantId",
        "startAt",
        "endAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "enrollmentId": {
          "type": "string",
          "format": "uuid"
        },
        "assistantId": {
          "type": "string",
          "format": "uuid"
        },
        "startAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "endAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "MobileReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "outcome",
        "code"
      ],
      "properties": {
        "eventId": {
          "oneOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "enum": [
            "accepted",
            "duplicate",
            "rejected",
            "retryable"
          ]
        },
        "code": {
          "enum": [
            "applied",
            "deleted",
            "invalid",
            "scope",
            "settingsChanged",
            "suppressed",
            "conflict",
            "quota",
            "unavailable"
          ]
        }
      }
    },
    "SyncResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "producerPin",
        "result"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "producerPin": {
          "$ref": "#/$defs/MobileContractPin"
        },
        "result": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/MobileReceipt"
          }
        }
      }
    },
    "MobileContractPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "schemaVersion",
        "digest"
      ],
      "properties": {
        "schemaId": {
          "const": "https://lifestream.dev/contracts/mobile-context/1.0.0"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "MobileSourceConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "categories",
        "uses",
        "assistantIds",
        "collectionPaused",
        "usePaused"
      ],
      "properties": {
        "categories": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SleepSegment",
              "heartRate",
              "restingHeartRate",
              "respiratoryRate",
              "hrvSDNN",
              "hrvRMSSD"
            ]
          }
        },
        "uses": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "answers",
              "summaries",
              "memory",
              "proactive"
            ]
          }
        },
        "assistantIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "collectionPaused": {
          "type": "boolean"
        },
        "usePaused": {
          "type": "boolean"
        },
        "preferredSource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "MobileEnrollmentRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enrollmentId",
        "principalId",
        "endpointId",
        "collector",
        "sourceNamespace",
        "revision",
        "state",
        "configuration"
      ],
      "properties": {
        "enrollmentId": {
          "type": "string",
          "format": "uuid"
        },
        "principalId": {
          "type": "string",
          "format": "uuid"
        },
        "endpointId": {
          "type": "string",
          "format": "uuid"
        },
        "collector": {
          "enum": [
            "healthKit",
            "healthConnect"
          ]
        },
        "sourceNamespace": {
          "oneOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "unbound",
            "active",
            "disconnected"
          ]
        },
        "configuration": {
          "$ref": "#/$defs/MobileSourceConfiguration"
        }
      }
    },
    "MobileEffectivePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyRevision",
        "sourceBound",
        "collectionAllowed",
        "categories",
        "uses",
        "assistantIds",
        "sourceNamespace"
      ],
      "properties": {
        "policyRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sourceBound": {
          "type": "boolean"
        },
        "collectionAllowed": {
          "type": "boolean"
        },
        "categories": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SleepSegment",
              "heartRate",
              "restingHeartRate",
              "respiratoryRate",
              "hrvSDNN",
              "hrvRMSSD"
            ]
          }
        },
        "uses": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "answers",
              "summaries",
              "memory",
              "proactive"
            ]
          }
        },
        "assistantIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "sourceNamespace": {
          "oneOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "PolicyResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "producerPin",
        "result"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "producerPin": {
          "$ref": "#/$defs/MobileContractPin"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enrollment",
            "effective"
          ],
          "properties": {
            "enrollment": {
              "$ref": "#/$defs/MobileEnrollmentRecord"
            },
            "effective": {
              "$ref": "#/$defs/MobileEffectivePolicy"
            }
          }
        }
      }
    }
  }
}
