{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifestream.dev/contracts/assistant-profile/2.0.0",
  "title": "AssistantProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assistantId", "profileId", "revision", "status", "corePersona", "adaptivePersonaPolicy", "createdAt", "createdBy"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "assistantId": { "$ref": "#/$defs/uuid" },
    "profileId": { "$ref": "#/$defs/uuid" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "active", "superseded", "retired"] },
    "corePersona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalName", "identityStatement", "values", "prohibitions", "relationshipBoundaries", "styleBoundaries"],
      "properties": {
        "canonicalName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "identityStatement": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "values": { "$ref": "#/$defs/nonEmptyStrings" },
        "prohibitions": { "$ref": "#/$defs/nonEmptyStrings" },
        "relationshipBoundaries": { "$ref": "#/$defs/nonEmptyStrings" },
        "styleBoundaries": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "adaptivePersonaPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions"],
      "properties": {
        "dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/dimension" },
          "uniqueItems": true
        }
      }
    },
    "createdAt": { "$ref": "#/$defs/time" },
    "createdBy": { "type": "string", "minLength": 1, "maxLength": 200 },
    "changeReason": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "extensions": { "type": "object", "propertyNames": { "pattern": "^[a-z0-9]+(?:\\.[a-z0-9-]+)+$" } }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f-]+$" },
    "time": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "valueType", "minimum", "maximum", "baseline", "maxDeltaPerDreamingRun", "maxDeltaPer30Days", "minimumIndependentEvidence", "confidenceThreshold", "reviewAfterDays", "sensitive", "activation"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]{0,63}$" },
        "valueType": { "const": "number" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "baseline": { "type": "number" },
        "maxDeltaPerDreamingRun": { "type": "number", "exclusiveMinimum": 0 },
        "maxDeltaPer30Days": { "type": "number", "exclusiveMinimum": 0 },
        "minimumIndependentEvidence": { "type": "integer", "minimum": 1 },
        "confidenceThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "reviewAfterDays": { "type": "integer", "minimum": 1 },
        "sensitive": { "type": "boolean" },
        "activation": { "enum": ["automatic", "humanApproval"] }
      },
      "allOf": [
        {
          "if": {
            "required": ["sensitive", "activation"],
            "properties": {
              "sensitive": { "const": true },
              "activation": { "enum": ["automatic", "humanApproval"] }
            }
          },
          "then": {
            "properties": { "activation": { "const": "humanApproval" } }
          }
        }
      ]
    }
  }
}
