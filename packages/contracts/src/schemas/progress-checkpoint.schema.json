{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifestream.dev/contracts/progress-checkpoint/1.0.0",
  "title": "ProgressCheckpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "branch", "baseRevision", "currentRevision", "activeSlice", "sliceStatus", "completedSlices", "allowedFiles", "changedFiles", "validation", "decisions", "blockers", "nextAction", "updatedAt", "updatedBy"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "repository": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "baseRevision": { "type": "string", "minLength": 7 },
    "currentRevision": { "type": "string", "minLength": 7 },
    "activeSlice": { "type": ["string", "null"], "pattern": "^LS-S[0-9]{3}$" },
    "sliceStatus": { "enum": ["notStarted", "inProgress", "blocked", "implemented", "verified"] },
    "completedSlices": { "type": "array", "items": { "type": "string", "pattern": "^LS-S[0-9]{3}$" }, "uniqueItems": true },
    "allowedFiles": { "$ref": "#/$defs/strings" },
    "changedFiles": { "$ref": "#/$defs/strings" },
    "validation": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "decisions": { "$ref": "#/$defs/strings" },
    "blockers": { "$ref": "#/$defs/strings" },
    "nextAction": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "updatedBy": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["command", "result"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "result": { "enum": ["pass", "fail", "notRun", "blocked"] },
        "evidence": { "type": "string" }
      }
    }
  }
}
