{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifestream.dev/contracts/protocol-common/1.0.0",
  "title": "ProtocolCommon",
  "$ref": "#/$defs/CallScope",
  "$defs": {
    "UUID": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f-]+$"
    },
    "Time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "Revision": {
      "type": "integer",
      "minimum": 1
    },
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "OpaqueRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "ExecutionMode": {
      "enum": [
        "normal",
        "replay",
        "simulation"
      ]
    },
    "PrivacyClass": {
      "enum": [
        "public",
        "personal",
        "sensitive",
        "restricted"
      ]
    },
    "CapabilityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "AuthorityContextRef": {
      "$ref": "https://lifestream.dev/contracts/capability-snapshot/2.0.0#/$defs/authorityContextRef"
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "sha256",
        "mediaType",
        "schemaRef",
        "byteLength"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "sha256": {
          "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/Digest"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "schemaRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ExternalEvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "reference",
        "schemaVersion"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "schemaVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        }
      }
    },
    "SourceRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerRef",
        "revision",
        "highWaterMark"
      ],
      "properties": {
        "providerRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "highWaterMark": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CallScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assistantId",
        "environmentId",
        "conversationId",
        "sessionId",
        "endpointId",
        "authorityContextRef",
        "interactionTraceId"
      ],
      "properties": {
        "assistantId": {
          "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID"
        },
        "environmentId": {
          "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID"
        },
        "conversationId": {
          "anyOf": [
            {
              "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID"
            },
            {
              "type": "null"
            }
          ]
        },
        "sessionId": {
          "anyOf": [
            {
              "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID"
            },
            {
              "type": "null"
            }
          ]
        },
        "endpointId": {
          "anyOf": [
            {
              "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorityContextRef": {
          "anyOf": [
            {
              "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/AuthorityContextRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "interactionTraceId": {
          "anyOf": [
            {
              "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "InteractionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assistantId",
        "environmentId",
        "conversationId",
        "sessionId",
        "endpointId",
        "interactionTraceId"
      ],
      "properties": {
        "assistantId": {
          "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID"
        },
        "environmentId": {
          "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID"
        },
        "conversationId": {
          "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID"
        },
        "sessionId": {
          "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID"
        },
        "endpointId": {
          "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID"
        },
        "interactionTraceId": {
          "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID"
        }
      }
    },
    "Problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "correlationId",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,119}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "retryable": {
          "type": "boolean"
        },
        "correlationId": {
          "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID"
        },
        "details": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "code"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 0,
                "maxLength": 500
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        }
      }
    },
    "Page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit",
        "cursor"
      ],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Reason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "summary"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRefs",
        "transformationId",
        "transformationVersion"
      ],
      "properties": {
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "transformationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "transformationVersion": {
          "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/Semver"
        }
      }
    },
    "EvidenceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memoryIds",
        "externalRefs"
      ],
      "properties": {
        "memoryIds": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID"
          },
          "uniqueItems": true
        },
        "externalRefs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/ExternalEvidenceRef"
          },
          "uniqueItems": true
        }
      },
      "anyOf": [
        {
          "properties": {
            "memoryIds": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "externalRefs": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      ]
    },
    "AudioFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "sampleRateHz",
        "channels"
      ],
      "properties": {
        "encoding": {
          "const": "pcm_s16le"
        },
        "sampleRateHz": {
          "enum": [
            16000,
            24000,
            48000
          ]
        },
        "channels": {
          "enum": [
            1,
            2
          ]
        }
      }
    },
    "AudioFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameId",
        "sequence",
        "format",
        "sampleOffset",
        "sampleCount",
        "dataBase64"
      ],
      "properties": {
        "frameId": {
          "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "format": {
          "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/AudioFormat"
        },
        "sampleOffset": {
          "type": "integer",
          "minimum": 0
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4800
        },
        "dataBase64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 25600,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "ProviderManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "providerRef",
        "adapterVersion",
        "ports",
        "contractProfile",
        "supportedSchemas",
        "streaming",
        "dataEgress",
        "health",
        "latencyClass"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "providerRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "adapterVersion": {
          "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/Semver"
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "contractProfile": {
          "const": "lifestream.ports.v1"
        },
        "supportedSchemas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schemaId",
              "sha256"
            ],
            "properties": {
              "schemaId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "sha256": {
                "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/Digest"
              }
            }
          }
        },
        "streaming": {
          "type": "boolean"
        },
        "dataEgress": {
          "enum": [
            "none",
            "local",
            "configuredRemote"
          ]
        },
        "health": {
          "enum": [
            "healthy",
            "degraded",
            "unavailable"
          ]
        },
        "latencyClass": {
          "enum": [
            "instant",
            "interactive",
            "slow",
            "background"
          ]
        }
      }
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 32000
        },
        {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": {
            "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/JsonValue"
          }
        }
      ]
    }
  }
}
