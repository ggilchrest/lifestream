{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifestream.dev/contracts/initiative-attention-receipt/1.0.0",
  "title": "Read-only temporary-attention processing marker and current host snapshot; never replay",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Response"
    }
  ],
  "$defs": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "idempotencyKey",
        "sessionId",
        "mode",
        "endpointId",
        "endpointRevision",
        "sessionRevision"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sessionId": {
          "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID"
        },
        "mode": {
          "enum": [
            "quiet",
            "clear"
          ]
        },
        "endpointId": {
          "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID"
        },
        "endpointRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sessionRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "Response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "relationshipId",
        "sessionId",
        "idempotencyKey",
        "mode",
        "state",
        "currentMode",
        "endsAt",
        "mutationDispatched",
        "endpointId",
        "endpointRevision",
        "sessionRevision"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "relationshipId": {
          "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID"
        },
        "sessionId": {
          "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "mode": {
          "enum": [
            "quiet",
            "clear"
          ]
        },
        "state": {
          "enum": [
            "recorded",
            "unknown",
            "unavailable"
          ]
        },
        "currentMode": {
          "enum": [
            "quiet",
            "clear",
            "companionship"
          ]
        },
        "endsAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "mutationDispatched": {
          "const": false
        },
        "endpointId": {
          "$ref": "https://lifestream.dev/contracts/protocol-common/1.0.0#/$defs/UUID"
        },
        "endpointRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sessionRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
