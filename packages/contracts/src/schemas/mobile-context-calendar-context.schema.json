{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifestream.dev/contracts/mobile-context-calendar-context/1.0.0",
  "title": "Explicit Calendar context read; observations and lineage are not permission.",
  "$ref": "#/$defs/CalendarContextQuery",
  "$defs": {
    "CalendarContextWindow": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "startAt",
            "endAt"
          ],
          "properties": {
            "kind": {
              "const": "instant"
            },
            "startAt": {
              "type": "string",
              "format": "date-time",
              "maxLength": 24
            },
            "endAt": {
              "type": "string",
              "format": "date-time",
              "maxLength": 24
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "startDate",
            "endDateExclusive"
          ],
          "properties": {
            "kind": {
              "const": "date"
            },
            "startDate": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "endDateExclusive": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "startLocal",
            "endLocal"
          ],
          "properties": {
            "kind": {
              "const": "floating"
            },
            "startLocal": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?$"
            },
            "endLocal": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?$"
            }
          }
        }
      ]
    },
    "CalendarContextQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "enrollmentId",
        "assistantId",
        "window"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "enrollmentId": {
          "type": "string",
          "format": "uuid"
        },
        "assistantId": {
          "type": "string",
          "format": "uuid"
        },
        "window": {
          "$ref": "#/$defs/CalendarContextWindow"
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[A-Za-z0-9_-]+\\.[a-f0-9]{64}$"
        }
      }
    },
    "CalendarContextLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKey",
        "suppressionKey",
        "recordDigest",
        "policyBindingDigest"
      ],
      "properties": {
        "sourceKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "suppressionKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recordDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policyBindingDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "CalendarContextRecord": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recordId",
            "source",
            "locator",
            "match",
            "reason",
            "lineage",
            "recordType",
            "record"
          ],
          "properties": {
            "recordId": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "source": {
              "$ref": "https://lifestream.dev/contracts/mobile-context-calendar/1.0.0#/$defs/CalendarSourceIdentity"
            },
            "locator": {
              "$ref": "https://lifestream.dev/contracts/mobile-context-calendar-delivery/1.0.0#/$defs/CalendarRecordLocator"
            },
            "match": {
              "enum": [
                "inWindow",
                "undetermined"
              ]
            },
            "reason": {
              "enum": [
                "timeWithinWindow",
                "incomparableClock",
                "unknownDue",
                "recurrenceNotExpanded"
              ]
            },
            "lineage": {
              "$ref": "#/$defs/CalendarContextLineage"
            },
            "recordType": {
              "const": "CalendarEvent"
            },
            "record": {
              "$ref": "https://lifestream.dev/contracts/mobile-context-calendar/1.0.0#/$defs/CalendarEvent"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recordId",
            "source",
            "locator",
            "match",
            "reason",
            "lineage",
            "recordType",
            "record"
          ],
          "properties": {
            "recordId": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "source": {
              "$ref": "https://lifestream.dev/contracts/mobile-context-calendar/1.0.0#/$defs/CalendarSourceIdentity"
            },
            "locator": {
              "$ref": "https://lifestream.dev/contracts/mobile-context-calendar-delivery/1.0.0#/$defs/CalendarRecordLocator"
            },
            "match": {
              "enum": [
                "inWindow",
                "undetermined"
              ]
            },
            "reason": {
              "enum": [
                "timeWithinWindow",
                "incomparableClock",
                "unknownDue",
                "recurrenceNotExpanded"
              ]
            },
            "lineage": {
              "$ref": "#/$defs/CalendarContextLineage"
            },
            "recordType": {
              "const": "Task"
            },
            "record": {
              "$ref": "https://lifestream.dev/contracts/mobile-context-calendar/1.0.0#/$defs/Task"
            }
          }
        }
      ]
    },
    "CalendarContextPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "asOf",
        "queryDigest",
        "enrollmentId",
        "sourceNamespace",
        "policyRevision",
        "policyBindingDigest",
        "coverage",
        "records",
        "nextCursor",
        "limitations"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "asOf": {
          "type": "string",
          "format": "date-time",
          "maxLength": 24
        },
        "queryDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "enrollmentId": {
          "type": "string",
          "format": "uuid"
        },
        "sourceNamespace": {
          "type": "string",
          "format": "uuid"
        },
        "policyRevision": {
          "type": "integer",
          "minimum": 1
        },
        "policyBindingDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "coverage": {
          "enum": [
            "partial",
            "unknown"
          ]
        },
        "records": {
          "type": "array",
          "maxItems": 25,
          "items": {
            "$ref": "#/$defs/CalendarContextRecord"
          }
        },
        "nextCursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^[A-Za-z0-9_-]+\\.[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    },
    "CalendarContextPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "schemaVersion",
        "digest"
      ],
      "properties": {
        "schemaId": {
          "const": "https://lifestream.dev/contracts/mobile-context-calendar-context/1.0.0"
        },
        "schemaVersion": {
          "const": "1.0.0"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "CalendarContextResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "producerPin",
        "result"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "producerPin": {
          "$ref": "#/$defs/CalendarContextPin"
        },
        "result": {
          "$ref": "#/$defs/CalendarContextPage"
        }
      }
    }
  }
}
