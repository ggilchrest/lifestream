{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifestream.dev/contracts/embodiment-state/1.0.0",
  "title": "EmbodimentState",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stateId", "interactionTraceId", "assistantId", "endpointId", "sequence", "effectiveAt", "source", "attention", "engagement", "affect", "speechState", "activity", "urgency"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "stateId": { "$ref": "#/$defs/uuid" },
    "interactionTraceId": { "$ref": "#/$defs/uuid" },
    "assistantId": { "$ref": "#/$defs/uuid" },
    "endpointId": { "$ref": "#/$defs/uuid" },
    "sequence": { "type": "integer", "minimum": 0 },
    "effectiveAt": { "$ref": "#/$defs/time" },
    "expiresAt": { "$ref": "#/$defs/time" },
    "source": { "enum": ["runtime", "behaviorController", "policyOverride", "replay"] },
    "attention": { "enum": ["none", "participant", "object", "environment", "task"] },
    "attentionTargetRef": { "type": "string", "minLength": 1, "maxLength": 500 },
    "engagement": { "enum": ["idle", "available", "engaged", "disengaging"] },
    "affect": {
      "type": "object", "additionalProperties": false, "required": ["valence", "arousal", "confidence"],
      "properties": {
        "valence": { "type": "number", "minimum": -1, "maximum": 1 },
        "arousal": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "speechState": { "enum": ["silent", "listening", "preparing", "speaking", "interrupted"] },
    "activity": { "enum": ["idle", "conversing", "working", "waiting", "notifying", "error"] },
    "urgency": { "enum": ["low", "normal", "high", "critical"] },
    "transitionHint": { "enum": ["immediate", "smooth", "endpointDefault"] },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f-]+$" },
    "time": { "type": "string", "format": "date-time", "pattern": "Z$" }
  }
}
