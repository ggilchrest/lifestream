{
  "name": "@lifestream/contracts",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./provider-messages": {
      "types": "./dist/provider-messages.d.ts",
      "import": "./dist/provider-messages.js"
    },
    "./experience": {
      "types": "./dist/experience.d.ts",
      "import": "./dist/experience.js"
    },
    "./visual-input": {
      "types": "./dist/visual-input.d.ts",
      "import": "./dist/visual-input.js"
    },
    "./visual-memory": {
      "types": "./dist/visual-memory.d.ts",
      "import": "./dist/visual-memory.js"
    },
    "./game-activity": {
      "types": "./dist/game-activity.d.ts",
      "import": "./dist/game-activity.js"
    }
  }
}
