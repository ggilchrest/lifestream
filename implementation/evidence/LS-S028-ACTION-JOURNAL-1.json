    "applicationTests": 837,
    "newJournalTests": 14,
    "focusedStorageTests": 26,
    "workspaceTests": 43,
    "joinedDispatchChecks": 46,
    "joinedContextChecks": 26,
    "applicationRestoresInJoinedDispatch": 5,
    "syntheticTargetCallsInJoinedDispatch": 4,
    "preservedDirtyArtifacts": 6
  },
  "earlierResults": "Initial type checking reported constructor definite-assignment errors, corrected by an explicit throwing catch. The first focused suite passed 24 of 25: the new post-commit fault test incorrectly used an input getter, which the existing bounded JSON guard rejected before the fault occurred. The test now injects file loss after a real committed transaction. An additional active WAL/shared-memory loss regression was added. Final focused storage suite passed 26 of 26 and full application suite passed 837 of 837. All initial logs are preserved.",
  "exclusions": [
    "Only ordinary application restore with a retained current separate safety journal is covered. Coordinated safety-state rollback, destroyed-journal recovery and administrator storage edits are not certified.",
